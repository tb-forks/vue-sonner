{
  "name": "@tb-dev/vue-sonner",
  "description": "Sonner for Vue",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "homepage": "https://github.com/tb-forks/vue-sonner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tb-forks/vue-sonner.git"
  },
  "scripts": {
    "build": "vite build",
    "format": "dprint fmt",
    "release": "pnpm run build && pnpm publish",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.6",
    "vite-plugin-dts": "=4.5.4",
    "vue-tsc": "^3.2.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ]
}
