{
  "name": "@tb-dev/vue-sonner",
  "description": "Sonner for Vue",
  "type": "module",
  "version": "1.0.6",
  "packageManager": "pnpm@11.8.0",
  "license": "MIT",
  "homepage": "https://github.com/tb-forks/vue-sonner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tb-forks/vue-sonner.git"
  },
  "scripts": {
    "build": "vite build",
    "format": "dprint fmt",
    "release": "pnpm run build && pnpm publish",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/language-core": "^3.3.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": ["dist"]
}
